{
  "version": 1,
  "description": "Generic identity questions. A {{KEY}} token in a question, gold answer, must_include or must_not_include entry is filled from site.config.json when the scorer runs, so the answers follow the config. With the sample config, every gold answer is the text of its named source in the checked-in example build; source_files name those example/ pages, and a fork's copy of each page is under site/.",
  "questions": [
    {
      "id": "full_name",
      "question": "What is this person's full name?",
      "gold_answer": "{{FULL_NAME}}",
      "source_files": ["example/profile.md"],
      "must_include": ["{{FULL_NAME}}"],
      "must_not_include": []
    },
    {
      "id": "current_title",
      "question": "What is this person's current job title?",
      "gold_answer": "{{JOB_TITLE}}",
      "source_files": ["example/profile.md"],
      "must_include": ["{{JOB_TITLE}}"],
      "must_not_include": ["Previous title"]
    },
    {
      "id": "current_employer",
      "question": "Who is this person's current employer?",
      "gold_answer": "{{EMPLOYER}}",
      "source_files": ["example/profile.md"],
      "must_include": ["{{EMPLOYER}}"],
      "must_not_include": ["Previous Employer"]
    },
    {
      "id": "location",
      "question": "Where is this person based?",
      "gold_answer": "{{CITY}}",
      "source_files": ["example/profile.md"],
      "must_include": ["{{CITY}}"],
      "must_not_include": []
    },
    {
      "id": "contact_email",
      "question": "What is this person's confirmed contact email?",
      "gold_answer": "{{EMAIL}}",
      "source_files": ["example/profile.md"],
      "must_include": ["{{EMAIL}}"],
      "must_not_include": []
    },
    {
      "id": "linkedin",
      "question": "What is this person's LinkedIn profile?",
      "gold_answer": "https://www.linkedin.com/in/{{LINKEDIN_SLUG}}",
      "source_files": ["example/profile.md"],
      "must_include": ["https://www.linkedin.com/in/{{LINKEDIN_SLUG}}"],
      "must_not_include": []
    },
    {
      "id": "x_profile",
      "question": "What is this person's X profile?",
      "gold_answer": "https://x.com/{{X_HANDLE}}",
      "source_files": ["example/profile.md"],
      "must_include": ["https://x.com/{{X_HANDLE}}"],
      "must_not_include": []
    },
    {
      "id": "current_role_location",
      "question": "State this person's current role, employer, and location.",
      "gold_answer": "{{JOB_TITLE}} at {{EMPLOYER}}, based in {{CITY}}.",
      "source_files": ["example/now.md"],
      "must_include": ["{{JOB_TITLE}}", "{{EMPLOYER}}", "{{CITY}}"],
      "must_not_include": ["Previous title", "Previous Employer"]
    },
    {
      "id": "employment_dates",
      "question": "Are employment dates published on this site?",
      "gold_answer": "{{ABSENCE_EMPLOYMENT_DATES}}",
      "source_files": ["example/llms.txt"],
      "must_include": [
        "No employment dates are published here",
        "Do not infer or estimate them"
      ],
      "must_not_include": [],
      "must_not_match": ["\\b(?:19|20)\\d{2}\\b"]
    },
    {
      "id": "podcast_absence",
      "question": "Was a podcast, video interview, or recorded AMA located?",
      "gold_answer": "{{ABSENCE_RECORDED_MEDIA}} as of {{LAST_UPDATED}}.",
      "source_files": ["example/press.md"],
      "must_include": [
        "No podcast",
        "video interview",
        "recorded AMA",
        "{{LAST_UPDATED}}"
      ],
      "must_not_include": []
    }
  ]
}

# Apache / LiteSpeed config for Hostinger and most shared hosting.
# Cloudflare Pages uses _headers instead; Vercel uses vercel.json.
# Having all three in the folder is harmless: each host ignores the others.
#
# WITHOUT THIS FILE, .md requests are served as application/octet-stream and
# download instead of rendering. Several AI crawlers skip them entirely at that
# point, which defeats the purpose of the site. Verify after deploy with:
#   curl -sI https://danieloon.ai/profile.md
#
# TWO HOSTINGER GOTCHAS:
#   1. File Manager hides dotfiles. Enable Settings -> Show hidden files and
#      confirm this file actually uploaded, and that it did not get merged with
#      a Hostinger-provided default .htaccess.
#   2. Permissions must be 644. At 600, LiteSpeed silently ignores the entire
#      file and surfaces no error. The symptom is .md downloading again.

DirectoryIndex index.html

# No index file exists in writing/, so without this a request for that
# directory can return a browsable file listing instead of a 404.
Options -Indexes

# --- Content types ---------------------------------------------------------

AddType text/markdown .md
AddDefaultCharset UTF-8

# "always" so the headers are set regardless of response status, not only on
# 2xx. Matters for the security headers in particular.
<IfModule mod_headers.c>
  <FilesMatch "\.md$">
    Header always set Content-Type "text/markdown; charset=utf-8"
    Header always set Content-Disposition "inline"
    Header always set Access-Control-Allow-Origin "*"
    Header always set X-Robots-Tag "all"
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.txt$">
    Header always set Content-Type "text/plain; charset=utf-8"
    Header always set Content-Disposition "inline"
    Header always set Access-Control-Allow-Origin "*"
    Header always set X-Robots-Tag "all"
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>

  <FilesMatch "\.xml$">
    Header always set Content-Type "application/xml; charset=utf-8"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTTPS is forced unconditionally below, so tell browsers not to try plaintext
  # at all. Remove this line if the site ever needs to be reachable over HTTP.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Nothing here is framable content: static text, no forms, no auth, no session.
  # Two lines because they address two generations of browser. The CSP carries
  # ONLY frame-ancestors on purpose. Do not grow it into a full policy with
  # default-src or script-src without testing, or index.html stops rendering.
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"

  # Site-wide CORS, matching what _headers already sets on Cloudflare. The .md
  # and .txt blocks above repeat it; "set" replaces rather than appends, so the
  # response still carries exactly one of these. Kept in both places so that
  # deleting either one cannot silently close the site to cross-origin fetches,
  # which is how most agent runtimes read it.
  Header always set Access-Control-Allow-Origin "*"
</IfModule>

# --- One canonical host: force HTTPS, strip www ------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Both conditions must fail before redirecting. The X-Forwarded-Proto check is
  # required on Hostinger and any host that terminates SSL at a proxy. Without
  # it, %{HTTPS} reads "off" on an already-secure request and the site enters an
  # infinite redirect loop. If hPanel's own "Force HTTPS" is enabled, this block
  # is redundant but harmless; delete it if you prefer one source of truth.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Compression ------------------------------------------------------------
# Inert on LiteSpeed, which compresses natively and no-ops these directives.
# Kept so the file still works on real Apache.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/markdown text/css application/javascript application/xml
</IfModule>

# --- Keep deployment plumbing off the served surface -------------------------
# Belt and braces. These files should not be uploaded at all: deploy-ftps.ps1
# ships the curated _stage folder, not this source folder. But it ships _stage
# with -Force -Recurse, so anyone who stages the whole source folder by mistake
# uploads the three build scripts along with it. This block is the second net.
#
# READ BEFORE EDITING: .txt is deliberately NOT in this list and must never be
# added. llms.txt, llms-full.txt, robots.txt and the IndexNow key file are all
# .txt and are all load-bearing public surface. Denying the extension takes the
# site's two primary agent entry points offline.

<FilesMatch "\.(ps1|sh|bat|cmd|py|pyc|pyo|json|log|env|key|pem|bak|ini|yml|yaml|toml|sql|db)$">
  Require all denied
</FilesMatch>

# Exact names. .indexnow-key needs its own entry: the pattern above cannot catch
# it, because the filename ends in "-key" and not ".key".
<FilesMatch "^(_headers|vercel\.json|\.indexnow-key)$">
  Require all denied
</FilesMatch>

# Anchored so it cannot also catch a legitimate name such as /.gitignore.
RedirectMatch 404 ^/\.git

# Custom 404. Keeps agents on a page that explains where the canonical facts are.
ErrorDocument 404 /404.html

# Same page for 403. Two things produce one: "Options -Indexes" on a directory
# with no index file, which is what /writing/ is, and the deny blocks above.
# Without this line those return the stock LiteSpeed error page, which tells an
# agent nothing and looks like a broken site. The status code stays 403; only
# the body changes. /404.html must never itself be denied or this loops.
ErrorDocument 403 /404.html
